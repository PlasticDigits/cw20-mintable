{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BlacklistResponse",
  "type": "object",
  "required": [
    "authority_epoch",
    "blocked",
    "epoch",
    "interface_version"
  ],
  "properties": {
    "authority_epoch": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "blocked": {
      "type": "boolean"
    },
    "epoch": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "interface_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "pending_clear": {
      "anyOf": [
        {
          "$ref": "#/definitions/PendingClear"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "PendingClear": {
      "type": "object",
      "required": [
        "executable_at",
        "initiator",
        "nonce",
        "proposed_at"
      ],
      "properties": {
        "executable_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "initiator": {
          "type": "string"
        },
        "nonce": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "proposed_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WalletResponse",
  "type": "object",
  "required": [
    "assignment",
    "initialized",
    "reserved",
    "rolling_spent",
    "state",
    "wallet"
  ],
  "properties": {
    "assignment": {
      "$ref": "#/definitions/Assignment"
    },
    "initialized": {
      "type": "boolean"
    },
    "pending": {
      "anyOf": [
        {
          "$ref": "#/definitions/PendingChange"
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_assignment": {
      "anyOf": [
        {
          "$ref": "#/definitions/PendingAssignment"
        },
        {
          "type": "null"
        }
      ]
    },
    "reserved": {
      "$ref": "#/definitions/Uint128"
    },
    "rolling_spent": {
      "$ref": "#/definitions/Uint128"
    },
    "state": {
      "$ref": "#/definitions/WalletState"
    },
    "wallet": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Assignment": {
      "type": "object",
      "required": [
        "allow_lock",
        "evidence_hash",
        "exempt",
        "protocol"
      ],
      "properties": {
        "allow_lock": {
          "type": "boolean"
        },
        "evidence_hash": {
          "type": "string"
        },
        "exempt": {
          "type": "boolean"
        },
        "protocol": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "Bucket": {
      "type": "object",
      "required": [
        "amount",
        "hour"
      ],
      "properties": {
        "amount": {
          "$ref": "#/definitions/Uint128"
        },
        "hour": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "Change": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "unlock"
          ]
        },
        {
          "type": "object",
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "$ref": "#/definitions/WalletPolicy"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "rebase"
          ],
          "properties": {
            "rebase": {
              "$ref": "#/definitions/Uint128"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "PendingAssignment": {
      "type": "object",
      "required": [
        "assignment",
        "authority_epoch",
        "executable_at",
        "initiator",
        "nonce",
        "proposed_at"
      ],
      "properties": {
        "assignment": {
          "$ref": "#/definitions/Assignment"
        },
        "authority_epoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "executable_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "initiator": {
          "type": "string"
        },
        "nonce": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "proposed_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "PendingChange": {
      "type": "object",
      "required": [
        "change",
        "executable_at",
        "initiator",
        "nonce",
        "proposed_at"
      ],
      "properties": {
        "change": {
          "$ref": "#/definitions/Change"
        },
        "executable_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "initiator": {
          "type": "string"
        },
        "nonce": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "proposed_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    },
    "WalletPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "limit_bps",
        "relaxation_delay",
        "unlock_delay"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "limit_bps": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "relaxation_delay": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "unlock_delay": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "WalletState": {
      "type": "object",
      "required": [
        "buckets",
        "locked",
        "policy",
        "protected_balance"
      ],
      "properties": {
        "buckets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Bucket"
          }
        },
        "locked": {
          "type": "boolean"
        },
        "policy": {
          "$ref": "#/definitions/WalletPolicy"
        },
        "protected_balance": {
          "$ref": "#/definitions/Uint128"
        }
      },
      "additionalProperties": false
    }
  }
}
